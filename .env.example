# Librus Synergia - Przykładowa konfiguracja zmiennych środowiskowych

# Standardowe dane logowania (używane w testach i skryptach)
LIBRUS_LOGIN=twoj_login
LIBRUS_PASSWORD=twoje_haslo

# Opcjonalne profile / konta do testów wielokontowych (skrypty w katalogu scripts/)
OLEK_LIBRUS_LOGIN=
OLEK_LIBRUS_PASS=

JULEK_LIBRUS_LOGIN=
JULEK_LIBRUS_PASS=

# Opcjonalnie: ręczne ciasteczka sesyjne do testów offline/debugowania
# LIBRUS_COOKIES=
